# ==============================================================================
# Environment Configuration for Adaptive TFTP IoT Firmware System
# ==============================================================================

# Project & Security
PROJECT_NAME="Adaptive TFTP IoT Firmware System"
SECRET_KEY="change-this-secret-key-in-production-long-random-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (MySQL required)
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=tftp_iot_db

# Async Database URL for SQLAlchemy + aiomysql
DATABASE_URL=mysql+aiomysql://root:your_mysql_password_here@127.0.0.1:3306/tftp_iot_db?charset=utf8mb4

# TFTP Server Configuration
TFTP_HOST=0.0.0.0
TFTP_PORT=6969
FIRMWARE_DIRECTORY=./firmware_repo
MAX_TFTP_THREADS=10
DEFAULT_TIMEOUT=2.0
MAX_RETRIES=5

# URLs
API_URL=http://localhost:8000/api
WEBSOCKET_URL=ws://localhost:8000/api/ws
